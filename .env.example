# Image version (see https://hub.docker.com/r/filebrowser/filebrowser/tags)
FB_VERSION=v2.63.23

# Host port for the web UI (8080 is used by qBittorrent)
FB_PORT=8081

# Same folder as DOWNLOADS_PATH in the qBittorrent repo's .env
DOWNLOADS_PATH=/Users/you/Downloads/torrents

# Where FileBrowser keeps its settings and database
FB_CONFIG_PATH=./config
FB_DATABASE_PATH=./database

# Must match qBittorrent's PUID/PGID. Check yours with `id -u` and `id -g`
PUID=501
PGID=20

TZ=America/New_York
